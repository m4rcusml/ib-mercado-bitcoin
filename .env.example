# Modo seguro para desenvolvimento local. Este e o unico modo suportado sem
# servicos externos; nao requer segredo e nao movimenta tokens em uma rede.
WALLET_PROVIDER=simulated

# Opcional: caminho do SQLite local (padrao: data/bridge.sqlite).
# MB_DATABASE_PATH=data/bridge.sqlite

# --- PoC Sepolia -----------------------------------------------------------
# Preencha SOMENTE em .env.local ou no cofre de segredos do ambiente. Nunca
# versione valores, nao use prefixo NEXT_PUBLIC_ para segredos e nao habilite
# WALLET_PROVIDER=privy antes de concluir as verificacoes da Fase 0 do roadmap.
#
# WALLET_PROVIDER=privy
# PRIVY_APP_ID=...
# Opcional: NEXT_PUBLIC_PRIVY_APP_ID=... (mesmo valor PUBLICO de PRIVY_APP_ID).
# A interface recebe o App ID pelo campo `privyAppId` de GET /api/state; esta
# variavel so documenta o identificador publico. NUNCA crie NEXT_PUBLIC_ para
# PRIVY_APP_SECRET ou qualquer outro segredo.
# PRIVY_APP_SECRET=...
# PIMLICO_API_KEY=...              (bundler ERC-4337; dashboard.pimlico.io, somente servidor)
# ALCHEMY_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/...
# MOCK_USDC_ADDRESS=0x...          (gerado por: bash scripts/poc/deploy-mock-usdc.sh)
# TREASURY_ADDRESS=0x...
# TREASURY_PRIVATE_KEY=0x...
#
# Opcionais (milissegundos; padroes entre parenteses):
# POC_OBSERVATION_TIMEOUT_MS=900000  (15 min: submitted/unknown -> failed + estorno)
# POC_SIGNATURE_TIMEOUT_MS=600000    (10 min: sem assinatura -> failed + estorno)
# POC_RECONCILE_INTERVAL_MS=5000     (intervalo do worker de reconciliacao)
#
# Valores obrigatorios para a PoC real devem ser validados no servidor:
# Sepolia (chainId 11155111), contrato ERC-20 esperado com 6 decimais,
# tesouraria autorizada e saldo de ETH/Mock USDC de teste. Nenhum destes
# valores torna o projeto apto para mainnet ou ativos reais.
#
# Antes de iniciar a PoC, execute `npm run preflight:poc`. O comando valida
# somente presenca e formato local; ele nunca imprime valores nem chama rede.

{
  "name": "mb-wallet-bridge-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "Simulador acadêmico de conta custodial e wallet pessoal para o MB Wallet Bridge",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:api": "node scripts/check-api.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  },
  "type": "module"
}

{
  "name": "mb-wallet-bridge-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "Simulador acadêmico de conta custodial e wallet pessoal para o MB Wallet Bridge",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:api": "node scripts/dev/check-api.mjs",
    "preflight:poc": "node scripts/poc/preflight-poc.mjs",
    "diagnose:sepolia": "node scripts/poc/sepolia-diagnostics.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "reconcile:onchain": "node scripts/poc/reconcile-onchain.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@privy-io/react-auth": "3.51.0",
    "@privy-io/server-auth": "1.14.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "^2.57.8"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "type": "module",
  "overrides": {
    "permissionless": {
      "ox": "0.14.56"
    }
  }
}
